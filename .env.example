# ==============================================================================
# PitchTrainer — Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env.local para customizar suas configurações locais.
# No MVP (Fase 1), o app funciona 100% Client-Side sem variáveis obrigatórias!
# ==============================================================================

# URL da aplicação (usado para OpenGraph e SEO na Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Modo de Áudio ('samples' para carregar arquivos da CDN/public, 'synth' para forçar síntese Karplus-Strong)
NEXT_PUBLIC_AUDIO_MODE="samples"

# Caminho base para os arquivos de áudio (CDN externa ou pasta local /audio)
NEXT_PUBLIC_AUDIO_BASE_PATH="/audio"

# ==============================================================================
# CONFIGURAÇÕES FUTURAS (Fase 4 - Supabase / Nuvem)
# Descomente apenas quando for integrar autenticação e banco de dados na nuvem:
# ==============================================================================
# NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-aqui"
